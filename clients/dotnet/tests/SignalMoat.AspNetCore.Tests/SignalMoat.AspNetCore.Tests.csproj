<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A self-contained test runner (no test framework packages needed).
    It starts the real SignalMoat decision API (Python) and runs the middleware against it:

        pip install -e "../../../..[server]"
        dotnet run -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>SignalMoat.AspNetCore.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SignalMoat.AspNetCore/SignalMoat.AspNetCore.csproj" />
  </ItemGroup>

</Project>
