<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>SentryCove.AspNetCore</RootNamespace>

    <PackageId>SentryCove.AspNetCore</PackageId>
    <Version>0.2.1</Version>
    <Authors>Siddharth Saraf</Authors>
    <Description>SentryCove middleware for ASP.NET Core: verify AI agents, enforce per-agent policies, and get early warning of probing, brute force and credential stuffing.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/XSiddhSaraf/sentrycove</PackageProjectUrl>
    <RepositoryUrl>https://github.com/XSiddhSaraf/sentrycove</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>security;bot-detection;ai-agents;aspnetcore;middleware;web-bot-auth</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SentryCove.AspNetCore.Tests" />
  </ItemGroup>

</Project>
